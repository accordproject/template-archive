// A reduced copy of org.accordproject.templatedata@1.0.0, carrying only the
// two extension points cicero-core resolves by name. The published namespace
// defines nothing else and imports nothing. Kept local because the namespace
// is not published yet.

concerto version "^3.0.0"

namespace org.accordproject.templatedata@1.0.0

/**
 * The extension point for a template's own data model.
 *
 * A template's model declares exactly one concrete subtype, and that
 * subtype is the template model: extending TemplateData is the
 * declaration, so no `@template` decorator is required to identify it.
 */
abstract concept TemplateData {}

/**
 * The extension point for template-specific runtime state.
 *
 * A template declares one concrete subtype and it is carried in the runtime
 * state envelope: state is composed into the envelope rather than subclassing
 * it, which is why this is an abstract concept and not an asset.
 */
abstract concept StateData {}
