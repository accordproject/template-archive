namespace org.accordproject.conga@1.0.0

import org.accordproject.templatedata@1.0.0.TemplateData from https://models.accordproject.org/accordproject/templatedata@1.0.0.cto
import org.accordproject.runtime@1.0.0.{Request, Response} from https://models.accordproject.org/accordproject/runtime@1.0.0.cto

/**
 * Defines the data model for the Conga template.
 */
concept TemplateModel extends TemplateData {
  o Double amount
  o String swag
  --> Participant participant
}

/**
 * A duplicate data model for testing. A model with two concrete subtypes of
 * TemplateData is ambiguous: cicero-core cannot tell which one is the
 * template model, and must reject it rather than guess.
 */
concept TemplateModel2 extends TemplateData {
  o Double amount
  o String swag
  --> Participant participant
}

/**
 * Defines the input data required by the template
 */
transaction Payup extends Request {
}

/**
 * Defines the output data for the template
 */
transaction CongaResponse extends Response {
  o String name
  o Double amount
}
