// A reduced copy of org.accordproject.obligation@1.0.0, carrying only the base
// obligation that cicero-core resolves by name. The published namespace also
// defines the concrete obligation kinds, the transition event and fulfilment
// evidence, none of which cicero-core looks up, and whose properties would
// pull in four further 1.0 namespaces. Kept local because the namespace is not
// published yet.

concerto version "^3.0.0"

namespace org.accordproject.obligation@1.0.0

/**
 * A durable obligation derived from an agreement.
 *
 * runtime@1.0.0 has no obligation of its own: obligation lifecycle is durable
 * state in this namespace rather than an event on the runtime API.
 */
abstract asset Obligation identified by obligationId {
  o String obligationId
  o DateTime createdAt
  o DateTime dueAt optional
  o String description optional
}
