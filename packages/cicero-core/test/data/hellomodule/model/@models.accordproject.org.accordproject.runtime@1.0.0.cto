// A reduced copy of org.accordproject.runtime@1.0.0, carrying only the base
// types cicero-core resolves by name. The published namespace also defines the
// agreement state envelope and its clause-state map; cicero-core looks up
// neither, and the map requires a Concerto version this package does not pin.
// Kept local because the namespace is not published yet.

concerto version "^3.0.0"

namespace org.accordproject.runtime@1.0.0

/**
 * Base request for invoking contract logic with no custom request properties.
 */
transaction Request {
}

/**
 * Base response for contract logic with no custom response properties.
 */
transaction Response {
}
